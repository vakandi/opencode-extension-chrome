{
   "action": {
      "default_icon": {
         "12": "icons/opencode-logo-dark-square-12.png",
         "128": "icons/opencode-logo-dark-square-128.png",
         "32": "icons/opencode-logo-dark-square-32.png",
         "48": "icons/opencode-logo-dark-square-48.png",
         "64": "icons/opencode-logo-dark-square-64.png"
      }
   },
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "content_scripts": [ {
      "js": [ "content/extract.js" ],
      "matches": [ "<all_urls>" ],
      "run_at": "document_idle"
   } ],
   "description": "Integrate OpenCode AI agent into your browser (local build, OpenCode v2 API)",
   "host_permissions": [ "<all_urls>" ],
   "icons": {
      "12": "icons/opencode-logo-dark-square-12.png",
      "128": "icons/opencode-logo-dark-square-128.png",
      "32": "icons/opencode-logo-dark-square-32.png",
      "48": "icons/opencode-logo-dark-square-48.png",
      "64": "icons/opencode-logo-dark-square-64.png"
   },
   "manifest_version": 3,
   "name": "OpenCode (v2 local)",
   "permissions": [ "tabs", "activeTab", "scripting", "storage", "sidePanel" ],
   "side_panel": {
      "default_path": "sidebar.html"
   },
   "version": "1.3.0"
}
